{
    "no-hard-tabs": {
        "code_blocks": false
    },
    "line-length": false,
    "commands-show-output": false,
    "no-duplicate-header": false,
    "no-duplicate-heading": false,
    "table-column-style": false,
    "no-inline-html": {
        "allowed_elements": [
            "a",
            "b",
            "br",
            "img",
            "p",
            "picture",
            "source"
        ]
    },
    "first-line-heading": false
}
